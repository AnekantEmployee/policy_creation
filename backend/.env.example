# ─── Tavily Search (for web research during profiling) ────────────────────────
TAVILY_API_KEY="your_tavily_api_key_here"

# ─── Authentication & Security ──────────────────────────────────────────────────
# IMPORTANT: Generate a new secret key for production using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="your-super-secret-key-change-this-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Optional: LiteLLM / other settings ──────────────────────────────────────
LITELLM_LOG=ERROR
CREWAI_TRACING_ENABLED=true

# ─── Groq API Keys (for LLM inference) ──────────────────────────────────────────
# Add multiple keys for load distribution
GROQ_API_KEY_1="your_groq_api_key_1"
GROQ_API_KEY_2="your_groq_api_key_2"
GROQ_API_KEY_3="your_groq_api_key_3"
GROQ_API_KEY_4="your_groq_api_key_4"
GROQ_API_KEY_5="your_groq_api_key_5"

# ─── Database (optional, defaults to SQLite) ─────────────────────────────────
# For production, use PostgreSQL or MySQL:
# DATABASE_URL="postgresql://user:password@localhost/compliance_db"
# DATABASE_URL="mysql://user:password@localhost/compliance_db"

# ─── Server Configuration ───────────────────────────────────────────────────────
# API_HOST and API_PORT for the FastAPI server
# API_HOST="0.0.0.0"  # Listen on all interfaces
# API_PORT="8001"

# ─── Frontend API URL (for chatbot/Streamlit integration) ──────────────────────
# Used when running Streamlit chatbot (backend/chatbot.py)
# API_BASE="http://localhost:8001"
